# Poort waarop het portaal luistert
PORT=3000

# Eerste admin-account (wordt enkel aangemaakt als er nog geen admins bestaan)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=verander-mij-nu

# Lange willekeurige string, bv. via: openssl rand -hex 32
JWT_SECRET=vervang-door-een-lange-willekeurige-string

# Map waar de data (JSON) wordt bewaard
DATA_DIR=/app/data

# Zet op true als het portaal achter HTTPS (reverse proxy) draait
COOKIE_SECURE=false

# Publieke adres van het portaal, voor links in Discord-berichten (optioneel)
PUBLIC_URL=https://lan.example.be
